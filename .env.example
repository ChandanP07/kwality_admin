# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/printcare_db?schema=public"

# ─────────────────────────────────────────────────────────────
# NEXTAUTH
# NEXTAUTH_URL must be the admin app's URL (this app)
# NEXTAUTH_SECRET must be the SAME value in both admin and client apps
# so that JWTs signed here are readable by the client app too.
# Generate one: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET=vBkMHXYE+Yr41ucsRyPa7d6DWD0wO6eVh330UJRnQvA=

# ─────────────────────────────────────────────────────────────
# GOOGLE OAUTH
# Get these from https://console.cloud.google.com
# Authorized redirect URIs must include:
#   http://localhost:3001/api/auth/callback/google  (admin app)
#   http://localhost:3000/api/auth/callback/google  (client app)
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ─────────────────────────────────────────────────────────────
# CLIENT APP URL (for CORS)
# The URL where the client Next.js app runs locally
# ─────────────────────────────────────────────────────────────
CLIENT_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# EMAIL (SMTP)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD="your-app-password"
SMTP_FROM="PrintCare System <your-email@gmail.com>"

# ─────────────────────────────────────────────────────────────
# APP SETTINGS
# ─────────────────────────────────────────────────────────────
NODE_ENV="development"
COMPANY_NAME="PrintCare Solutions"
COMPANY_EMAIL="support@printcare.com"
COMPANY_PHONE="+91-XXXX-XXXX-XXX"
BCRYPT_ROUNDS=12
